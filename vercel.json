{
  "regions": ["icn1"],
  "buildCommand": "npx vitest run && next build",
  "ignoreCommand": "bash -c '[[ \"$VERCEL_GIT_COMMIT_REF\" == dependabot/* ]]'",
  "crons": [
    {
      "path": "/api/cron/discover-castings",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/purge-parse-failures",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/generate-poster-thumbnails",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/sync-bug-reports",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/merge-user-shows",
      "schedule": "30 21 * * *"
    }
  ]
}
