  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "test": "vitest",
    "test:ui": "vitest --ui --coverage",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
