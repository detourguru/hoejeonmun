    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sharp": "0.35.5",
